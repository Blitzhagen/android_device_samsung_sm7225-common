    name: "secril_fwready",
    srcs: [
        "secril_fwready.cpp",
        "SehRadioIndication.cpp",
        "SehRadioResponse.cpp",
    ],
    system_ext_specific: true,
    init_rc: ["secril_fwready.rc"],
    shared_libs: [
        "libbase",
        "libhidlbase",
        "liblog",
        "libutils",
        "vendor.samsung.hardware.radio@2.0",
        "vendor.samsung.hardware.radio@2.1",
        "vendor.samsung.hardware.radio@2.2",
    ],
}
