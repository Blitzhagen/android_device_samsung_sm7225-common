type argosd, domain;
type argosd_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(argosd)

type btcoex_cont, domain;
type btcoex_cont_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(btcoex_cont)

type cassd, domain;
type cassd_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(cassd)

type emservice, domain;
type emservice_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(emservice)

type mfgloader, domain;
type mfgloader_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mfgloader)
allow mfgloader self:capability sys_module;
allow mfgloader vendor_firmware_file:file r_file_perms;
allow mfgloader vendor_file:file r_file_perms;

type snap_hidl, domain, halserverdomain;
type snap_hidl_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(snap_hidl)
allow snap_hidl snap_hwservice:hwservice_manager add;
allow snap_hidl hal_snap_service:service_manager add;

type snap_utility, domain;
type snap_utility_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(snap_utility)

type vaultkeeperd, domain;
type vaultkeeperd_exec, exec_type, vendor_file_type, file_type;
type vaultkeeper_efs_file, file_type;
type vaultkeeper_socket, file_type;
init_daemon_domain(vaultkeeperd)
allow vaultkeeperd vaultkeeper_efs_file:dir create_dir_perms;
allow vaultkeeperd vaultkeeper_efs_file:file create_file_perms;
allow vaultkeeperd vaultkeeper_socket:sock_file create_file_perms;
allow vaultkeeperd hal_vaultkeeper_server_hwservice:hwservice_manager add;

type sec_wifi_data_file, file_type, data_file_type;

# argosd (DVFS booster): net stats, devicetree soc info, qos device
allow argosd proc_net:file r_file_perms;
allow argosd vendor_sysfs_devicetree_soc:dir r_dir_perms;
allow argosd vendor_sysfs_devicetree_soc:file r_file_perms;
allow argosd radio_qos_device:chr_file rw_file_perms;

# emservice: registers vndservice + talks to suspend HAL / rild socket
allow emservice EngineeringMode_vndservice:service_manager add;
allow emservice hal_system_suspend_service:service_manager find;
binder_call(emservice, servicemanager)
binder_call(emservice, system_suspend_server)
binder_call(system_suspend_server, emservice)
allow emservice rild:unix_stream_socket connectto;

# vaultkeeperd prop read
get_prop(vaultkeeperd, hwservicemanager_prop)
hwbinder_use(vaultkeeperd)

# emservice: ion/qseecom + vndbinder plumbing
allow emservice ion_device:chr_file rw_file_perms;
allow emservice tee_device:chr_file rw_file_perms;
vndbinder_use(emservice)
binder_call(emservice, vndservicemanager)

# snap_utility reads its cache under /data/vendor/snap
allow snap_utility vendor_data_file:file r_file_perms;

# emservice enumerates /dev/block during em checks
allow emservice block_device:dir search;

# snap_hidl aidl service registration
binder_call(snap_hidl, servicemanager)

# vaultkeeperd reads qseecomd prop + logs to kmsg + enumerates /dev/block
get_prop(vaultkeeperd, vendor_qseecomd_prop)
allow vaultkeeperd kmsg_device:chr_file rw_file_perms;
allow vaultkeeperd block_device:dir r_dir_perms;
# untyped default_prop reads are neverallow'd; keep denied + quiet
dontaudit vaultkeeperd default_prop:file r_file_perms;
dontaudit emservice default_prop:file r_file_perms;

# emservice reads steady partition + sets props
allow emservice steady_block_device:blk_file r_file_perms;
unix_socket_connect(emservice, property, init)
allow vaultkeeperd steady_block_device:blk_file r_file_perms;
allow vaultkeeperd tee_device:chr_file rw_file_perms;
allow vaultkeeperd ion_device:chr_file rw_file_perms;
# vaultkeeperd keeps its own socket dir, sets props, writes steady partition
allow vaultkeeperd vaultkeeper_socket:dir r_dir_perms;
unix_socket_connect(vaultkeeperd, property, init)
allow vaultkeeperd steady_block_device:blk_file rw_file_perms;
