allow system_app proc_pagetypeinfo:file { read open getattr };

# Audio
binder_call(system_app, hal_audio_default)

# ZRAM
allow system_app sysfs_zram:dir search;
allow system_app sysfs_zram:file { read open getattr };

binder_call(system_app, hal_power_default)
binder_call(system_app, hal_vibrator_default)

# Sensors
binder_call(system_app, hal_sensors_default)

# Wifi
binder_call(system_app, hal_wifi_supplicant_default)

# Misc
binder_call(system_app, vold)

dontaudit system_app system_suspend_control_service:service_manager { find };
dontaudit system_app system_suspend_control_internal_service:service_manager { find };

# apexservice find is neverallow'd outside init/apexd/keystore/system_server;
# the lookups are opportunistic, keep denied + quiet
dontaudit system_app apex_service:service_manager find;

# UDFPS
