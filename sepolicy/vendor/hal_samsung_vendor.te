type hal_samsung_c2_default, domain;
type hal_samsung_c2_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_samsung_c2_default)
hal_server_domain(hal_samsung_c2_default, hal_codec2)
allow hal_samsung_c2_default hal_codec2_hwservice:hwservice_manager add;

# fkey/proca TEE + ion access (observed denials: qseecom ioctls, ion alloc)
allow hal_fkey_default tee_device:chr_file rw_file_perms;
allow hal_fkey_default ion_device:chr_file rw_file_perms;
binder_call(hal_fkey_default, servicemanager)

allow hal_proca_default tee_device:chr_file rw_file_perms;
allow hal_proca_default ion_device:chr_file rw_file_perms;

# HYPER HAL: perf/devfreq/kgsl sysfs + schedtune boost + aidl service
allow hal_hyper_default sysfs_power_writable:file rw_file_perms;
allow hal_hyper_default vendor_sysfs_devfreq:dir r_dir_perms;
allow hal_hyper_default vendor_sysfs_devfreq:file r_file_perms;
allow hal_hyper_default vendor_sysfs_kgsl:file r_file_perms;
allow hal_hyper_default cgroup:file rw_file_perms;
binder_call(hal_hyper_default, servicemanager)
# untyped default_prop reads are neverallow'd; keep denied + quiet
dontaudit hal_hyper_default default_prop:file r_file_perms;
binder_call(hal_converter_default, servicemanager)
